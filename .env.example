# ---- Local development (discrete Postgres vars) ----
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pdm_enrollment
DB_USER=postgres
DB_PASSWORD=your_password_here

# ---- Production (Neon / Render) ----
# When DATABASE_URL is set it takes precedence over DB_* above and SSL is used.
# DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require

# JWT
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# Server
PORT=3000
NODE_ENV=development

# Client (CORS origin for cross-origin setups; unused for the single-service deploy)
CLIENT_URL=http://localhost:5173

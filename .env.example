# ─── Database ───────────────────────────────────────────
# When DATABASE_URL is set it takes precedence over the DB_* vars and uses SSL.
# Production (Neon):
# DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require

# Local Postgres (used only when DATABASE_URL is not set):
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pdm_enrollment
DB_USER=postgres
DB_PASSWORD=your_password_here

# ─── Auth ───────────────────────────────────────────────
JWT_SECRET=your_jwt_secret_here   # REQUIRED in production (server refuses to boot on the default)
JWT_EXPIRES_IN=7d

# ─── Server ─────────────────────────────────────────────
PORT=3000
NODE_ENV=development
# CORS origin — in production set to the frontend (static site) URL:
CLIENT_URL=http://localhost:5173

# ─── Cloudinary (image uploads) ─────────────────────────
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# ─── Frontend build (client) ────────────────────────────
# Backend API origin baked into the SPA at build time (two-service deploy).
# Leave unset locally — Vite proxies /api to the backend in dev.
# VITE_API_URL=https://pdm-enrollment-api.onrender.com
